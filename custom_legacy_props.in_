; ==============================================================================
; NightDriver - Shelved Legacy Props & Specialized Board Configurations
; ==============================================================================
; This file contains historic prop environments (costumes, lanterns, fans, art)
; and vintage/specialized development boards that are not part of the active
; workbench or default CI build.
;
; TO ACTIVATE:
; Rename or copy this file to 'custom_legacy_props.ini' in the project root:
;   cp custom_legacy_props.in_ custom_legacy_props.ini
;
; PlatformIO automatically loads any 'custom_*.ini' file via extra_configs in
; platformio.ini.
; ==============================================================================

; ==============================================================================
; Legacy Hardware Profiles (Boards & Modules)
; ==============================================================================


[dev_adafruit_feather]
extends         = dev_esp32_s3
board           = adafruit_feather_esp32s3_tft
monitor_speed   = 115200
upload_speed    = 1500000
build_flags     = ${dev_esp32_s3.build_flags}
                  -DUSER_SETUP_LOADED
                  -DST7789_2_DRIVER
                  -DTFT_WIDTH=135
                  -DTFT_HEIGHT=240
                  -DTFT_BL=45
                  -DTFT_BACKLIGHT_ON=HIGH
                  -DTFT_RGB_ORDER=TFT_RGB
                  -DTFT_CS=7
                  -DTFT_DC=39
                  -DTFT_RST=40
                  -DTFT_MOSI=35
                  -DTFT_MISO=37
                  -DTFT_SCLK=36
                  -DLOAD_GLCD=1
                  -DLOAD_GFXFF=1
                  -DSPI_FREQUENCY=27000000
                  -DUSE_HSPI_PORT=1
build_src_flags = ${feature_wifi.build_src_flags}
                  -DUSE_SCREEN=1
                  -DUSE_TFTSPI=1
                  -DTOUCH_CS=0
                  -DENABLE_WIFI=1
                  -DESP32FEATHERTFT=1
                  -DTOGGLE_BUTTON_0=0

board_build.partitions = config/partitions_custom_noota_v3.csv
lib_deps        = ${dev_esp32_s3.lib_deps}
                  ${base.network_deps}
                  ${base.bounce_deps}
                  bodmer/TFT_eSPI @ ^2.5.43

[dev_heltec_wifi_v2]
extends         = dev_heltec_wifi
board           = heltec_wifi_kit_32_v2
monitor_speed   = 115200
upload_speed    = 921600
build_flags     = ${dev_heltec_wifi.build_flags}
                  -DARDUINO_HELTEC_WIFI_KIT_32_V2=1
build_src_flags = ${dev_heltec_wifi.build_src_flags}
                  -DUSE_SSD1306=1

lib_deps        = ${dev_heltec_wifi.lib_deps}
                  heltecautomation/Heltec ESP32 Dev-Boards @ ^1.1.1

[dev_heltec_wifi_v3]
extends         = dev_esp32_s3
board           = heltec_wifi_kit_32_V3
monitor_speed   = 115200
upload_speed    = 921600
build_flags     = ${dev_esp32_s3.build_flags}
                  -DARDUINO_HELTEC_WIFI_KIT_32=1
                  -DARDUINO_HELTEC_WIFI_KIT_32_V3=1
build_src_flags = -DUSE_SCREEN=1
                  -DUSE_SSD1306=1
                  -DTOGGLE_BUTTON_1=0
                  -DDEFAULT_INFO_PAGE=0

lib_deps        = ${dev_esp32_s3.lib_deps}
                  ${base.network_deps}
                  ${base.oled_deps}
                  ${base.bounce_deps}
                  heltecautomation/Heltec ESP32 Dev-Boards @ ^1.1.1

[dev_heltec_wifi_lora_v3]
extends         = dev_esp32_s3
board           = heltec_wifi_lora_32_V3
build_flags     = ${dev_esp32_s3.build_flags}
                  -DARDUINO_HELTEC_WIFI_KIT_32=1
                  -DARDUINO_HELTEC_WIFI_LORA_32_V3=1
build_src_flags = -DUSE_SCREEN=1
                  -DUSE_SSD1306=1

lib_deps        = ${dev_esp32_s3.lib_deps}
                  ${base.network_deps}
                  ${base.oled_deps}
                  heltecautomation/Heltec ESP32 Dev-Boards @ ^1.1.1

[dev_m5stack]
extends         = dev_m5
board           = m5stack-core2
build_src_flags = ${dev_m5.build_src_flags}
                  -DM5STACKCORE2=1
board_build.partitions = config/partitions_custom_8M_v3.csv
board_upload.flash_size = 8MB

[dev_elecrow_mesmerizer]
extends         = dev_esp32_s3
board           = esp32-s3-devkitc-1
monitor_speed   = 115200
upload_speed    = 1500000
lib_deps        = ${dev_esp32_s3.lib_deps}
                  ${base.network_deps}
                  ${base.oled_deps}
                  lovyan03/LovyanGFX @ ^1.1.7

[dev_tinypico]
extends         = base
board           = tinypico
monitor_speed   = 115200
upload_speed    = 1500000

[dev_wrover]
extends         = base
board           = esp-wrover-kit
monitor_speed   = 115200
upload_speed    = 1500000
lib_deps        = ${base.lib_deps}
                  ${base.network_deps}
                  ${base.network_deps}
                  adafruit/Adafruit ILI9341 @ ^1.5.10

[dev_lilygo_tdisplay_s3]
extends         = dev_esp32_s3
board           = esp32-s3-devkitc-1
build_src_flags = -DLILYGOTDISPLAYS3=1
                  -DPIN_SDA=21
                  -DTOGGLE_BUTTON_0=0
                  -DTOGGLE_BUTTON_1=14
lib_deps        = ${dev_esp32_s3.lib_deps}
                  ${base.network_deps}
                  ${base.bounce_deps}

[dev_lilygo_amoled]
extends        = dev_esp32_s3
board          = lilygo-t-amoled
monitor_speed  = 115200
upload_speed   = 1500000
build_flags    = ${dev_esp32_s3.build_flags}
                  -DARDUINO_USB_CDC_ON_BOOT=1
                  -DLV_CONF_PATH="../../../../include/amoled/lv_conf.h"
                  -DLV_CONF_INCLUDE_SIMPLE
                  ${psram_common_flags.build_flags}
build_src_flags = -DLILYGO_TDISPLAY_AMOLED_SERIES=1
                  -DAMOLED_S3=1
                  -DUSE_SCREEN=1
                  -DTOGGLE_BUTTON_0=21
                  -DTOGGLE_BUTTON_1=0
                  -DLED_PIN0=2
lib_deps       = ${dev_esp32_s3.lib_deps}
                 ${base.network_deps}
                 lewisxhe/SensorLib@^0.1.4
                 lewisxhe/XPowersLib@^0.2.1
                 https://github.com/lvgl/lvgl.git#release/v8.3
                 ${base.bounce_deps}

; ==============================================================================
; Legacy Helper / Recipe Configurations
; ==============================================================================


[project_minimal_wifi_audio]
build_src_flags = ${project_minimal.build_src_flags}
                  ${feature_wifi.build_src_flags}
                  ${feature_audio.build_src_flags}

[project_minimal_wifi_audio_remote]
build_src_flags = ${project_minimal.build_src_flags}
                  ${feature_wifi.build_src_flags}
                  ${feature_audio.build_src_flags}
                  ${feature_remote.build_src_flags}

[project_minimal_audio]
build_src_flags = ${project_minimal.build_src_flags}
                  ${feature_audio.build_src_flags}

[project_minimal_audio_remote]
build_src_flags = ${project_minimal.build_src_flags}
                  ${feature_audio.build_src_flags}
                  ${feature_remote.build_src_flags}

[feature_wifi_audio_remote]
build_src_flags = ${feature_wifi.build_src_flags}
                  ${feature_audio.build_src_flags}
                  ${feature_remote.build_src_flags}

; ==============================================================================
; Shelved Environments
; ==============================================================================


; Daft Punk style cosplay / motorcycle helmet with a 24-LED NeoPixel ring on M5StickC-Plus
[env:helmet]
extends         = dev_m5stick_c_plus
build_src_flags = ${dev_m5stick_c_plus.build_src_flags}
                  ${project_spectrum.build_src_flags}
                  ${feature_wifi.build_src_flags}
                  ${feature_remote.build_src_flags}
                  ${feature_audio.build_src_flags}
                  -DSHOW_VU_METER=1
                  -DPROJECT_NAME="\"Helmet\""
                  -DPOWER_LIMIT_MW=1000
                  -DTIME_BEFORE_LOCAL=2
                  -DDEFAULT_EFFECT_INTERVAL=0
                  -DLED_PIN0=26
                  -DRING_SIZE_0=24
                  -DMATRIX_WIDTH=32
                  -DMATRIX_HEIGHT=8
                  -DNUM_FANS=MATRIX_WIDTH
                  -DFAN_SIZE=MATRIX_HEIGHT
                  -DLED_FAN_OFFSET_BU=6

; Dave's wearable belt buckle on an ultra-compact TinyPico using 5 concentric LED rings (31 LEDs)
[env:chieftain]
extends         = dev_tinypico
build_src_flags = ${project_minimal.build_src_flags}
                  ${feature_wifi.build_src_flags}
                  ${feature_audio.build_src_flags}
                  -DPROJECT_NAME='"Chieftain"'
                  -DTIME_BEFORE_LOCAL=5
                  -DMATRIX_WIDTH=12
                  -DNUM_LEDS=12
                  -DDEFAULT_EFFECT_INTERVAL=20000
                  -DRING_SIZE_0=1
                  -DRING_SIZE_1=2
                  -DRING_SIZE_2=4
                  -DRING_SIZE_3=8
                  -DRING_SIZE_4=16

lib_deps        = ${base.network_deps}
                  ${dev_tinypico.lib_deps}

; LED-illuminated umbrella with addressable strips running along canopy ribs on bare ESP32
[env:umbrella]
extends         = dev_esp32
build_src_flags = ${project_minimal.build_src_flags}
                  ${feature_wifi.build_src_flags}
                  ${feature_ota.build_src_flags}
                  ${feature_remote.build_src_flags}
                  ${feature_audio.build_src_flags}
                  -DUMBRELLA=1
                  -DPROJECT_NAME='"Umbrella"'
                  -DCOLOR_ORDER=EOrder::RGB
                  -DTIME_BEFORE_LOCAL=2
                  -DIR_REMOTE_PIN=39
                  -DDEFAULT_EFFECT_INTERVAL=1800000
                  -DLED_PIN1=16
                  -DLED_PIN2=17
                  -DLED_PIN3=18
                  -DLED_PIN4=32
                  -DLED_PIN5=33
                  -DLED_PIN6=23
                  -DLED_PIN7=22
                  -DMATRIX_WIDTH=228
                  -DONBOARD_LED_R=16
                  -DONBOARD_LED_G=17
                  -DONBOARD_LED_B=18
                  -DTOGGLE_BUTTON_0=0

lib_deps        = ${base.bounce_deps}
                  ${base.network_deps}
                  ${dev_esp32.lib_deps}

; Handheld / folding Japanese fan with concentric LED rings and custom fan warp effects on M5StickC-Plus
[env:fanset]
extends         = dev_m5stick_c_plus
build_src_flags = ${dev_m5stick_c_plus.build_src_flags}
                  ${feature_wifi_audio_remote.build_src_flags}
                  -DFANSET=1
                  -DEFFECTS_FAN=1
                  -DPROJECT_NAME="\"Fan set\""
                  -DINCOMING_WIFI_ENABLED=0
                  -DTIME_BEFORE_LOCAL=2
                  -DENABLE_NTP=0
                  -DCOLORDATA_SERVER_ENABLED=0
                  -DMIN_BUFFERS=1
                  -DMAX_BUFFERS=1
                  -DDEFAULT_EFFECT_INTERVAL=60*60*24*5
                  -DLED_PIN0=26
                  -DNUM_FANS=10
                  -DNUM_BANDS=8
                  -DFAN_SIZE=16
                  -DBONUS_PIXELS=32
                  -DMATRIX_WIDTH=NUM_FANS*FAN_SIZE+BONUS_PIXELS
                  -DNUM_LEDS=MATRIX_WIDTH
                  -DLED_FAN_OFFSET_BU=3

monitor_filters = esp32_exception_decoder

; Lighted automotive license plate frame perimeter (40 LEDs) driven by M5StickC-Plus
[env:platecover]
extends         = dev_m5stick_c_plus
build_src_flags = ${dev_m5stick_c_plus.build_src_flags}
                  ${project_minimal_audio_remote.build_src_flags}
                  -DFASTLED_EXPERIMENTAL_ESP32_RGBW_ENABLED=1
                  -DFASTLED_EXPERIMENTAL_ESP32_RGBW_MODE=kRGBWMaxBrightness
                  -DPROJECT_NAME='"Plate Cover"'
                  -DENABLE_WIFI=1
                  -DENABLE_ESPNOW=1
                  -DTIME_BEFORE_LOCAL=3
                  -DMATRIX_WIDTH=40
                  -DNUM_LEDS=40
                  -DIR_REMOTE_PIN=26
                  -DUSE_SCREEN=1
                  -DFAN_SIZE=40
                  -DLED_PIN0=32
                  -DDEFAULT_EFFECT_INTERVAL=0
                  -DCOLOR_ORDER=EOrder::BRG

; Five antique glass telegraph line insulators lit from underneath by 12-LED rings on M5StickC-Plus
[env:insulators]
extends         = dev_m5stick_c_plus
build_src_flags = ${dev_m5stick_c_plus.build_src_flags}
                  ${project_minimal.build_src_flags}
                  ${feature_audio.build_src_flags}
                  -DINSULATORS=1
                  -DPROJECT_NAME='"Insulators"'
                  -DTIME_BEFORE_LOCAL=0
                  -DDEFAULT_EFFECT_INTERVAL=0
                  -DLED_PIN0=26
                  -DRING_SIZE_0=12
                  -DMATRIX_WIDTH=5
                  -DMATRIX_HEIGHT=12
                  -DNUM_FANS=5
                  -DFAN_SIZE=12
                  -DNUM_LEDS=60
                  -DIR_REMOTE_PIN=26
                  -DLED_FAN_OFFSET_BU=6

; Single illuminated antique glass telegraph line insulator on M5StickC-Plus
[env:single_insulator]
extends         = dev_m5stick_c_plus
build_src_flags = ${dev_m5stick_c_plus.build_src_flags}
                  ${project_minimal_audio.build_src_flags}
                  -DPROJECT_NAME="\"Single Insulator\""
                  -DDEFAULT_EFFECT_INTERVAL=10*60*24
                  -DNUM_FANS=1
                  -DFAN_SIZE=12
                  -DBONUS_PIXELS=7
                  -DMATRIX_WIDTH=NUM_FANS*FAN_SIZE+BONUS_PIXELS
                  -DMATRIX_HEIGHT=NUM_FANS
                  -DLED_FAN_OFFSET_BU=6
                  -DLED_PIN0=26

; Infinity / two-way "Magic Mirror" with a 100-LED perimeter strip on M5StickC
[env:magicmirror]
extends         = dev_m5stick_c
build_src_flags = ${dev_m5stick_c.build_src_flags}
                  ${project_minimal_audio_remote.build_src_flags}
                  -DPROJECT_NAME='"Magic Mirror"'
                  -DDEFAULT_EFFECT_INTERVAL=14400
                  -DLED_PIN0=26
                  -DFAN_SIZE=100
                  -DMATRIX_WIDTH=100
                  -DNUM_LEDS=100
                  -DIR_REMOTE_PIN=15
                  -DLED_FAN_OFFSET_BU=6

; Ultra-compact M5Stack ATOM Lite controller driving a NeoPixel ring/accent light
[env:atomlight]
extends         = dev_esp32
build_src_flags = ${project_minimal_wifi_audio_remote.build_src_flags}
                  -DATOMLIGHT=1
                  -DPROJECT_NAME="\"Atom Light\""
                  -DTIME_BEFORE_LOCAL=3
                  -DNUM_CHANNELS=4
                  -DMATRIX_WIDTH=53
                  -DIR_REMOTE_PIN=35
                  -DFAN_SIZE=NUM_LEDS
                  -DLED_PIN1=16
                  -DLED_PIN2=17
                  -DLED_PIN3=18
                  -DDEFAULT_EFFECT_INTERVAL=1000*60*5

lib_deps        = ${base.bounce_deps}
                  ${base.network_deps}
                  ${dev_esp32.lib_deps}

; 3D-printed spiral desk lamp with a 172-LED continuous strip coil on M5StickC-Plus
[env:spirallamp]
extends         = dev_m5stick_c_plus
build_src_flags = ${dev_m5stick_c_plus.build_src_flags}
                  ${project_minimal_wifi_audio_remote.build_src_flags}
                  -DPROJECT_NAME='"Spiral Light"'
                  -DTIME_BEFORE_LOCAL=3
                  -DNUM_CHANNELS=2
                  -DMATRIX_WIDTH=172
                  -DNUM_LEDS=172
                  -DIR_REMOTE_PIN=26
                  -DUSE_SCREEN=1
                  -DFAN_SIZE=172
                  -DFULL_COLOR_REMOTE_FILL=1
                  -DBRIGHTNESS_MIN=0
                  -DLED_PIN0=32
                  -DLED_PIN1=33
                  -DDEFAULT_EFFECT_INTERVAL=300000

;==============
; Simplified project definitions using base board types + project defines + effect sets

; Laser diffraction / straight-line beam lighting effect on M5StickC-Plus
[env:laserline]
extends         = dev_m5stick_c_plus
build_src_flags = ${dev_m5stick_c_plus.build_src_flags}
                  ${project_minimal.build_src_flags}
                  ${feature_audio.build_src_flags}
                  -DPROJECT_NAME="\"Laser Line\""
                  -DTIME_BEFORE_LOCAL=0
                  -DDEFAULT_EFFECT_INTERVAL=60*60*24*5
                  -DMATRIX_WIDTH=700
                  -DLED_FAN_OFFSET_BU=6
                  -DLED_PIN0=32

; Decorative camping lantern using a 4-tier concentric ring stack (37 LEDs) on M5StickC
[env:lantern]
extends         = dev_m5stick_c
build_src_flags = ${dev_m5stick_c.build_src_flags}
                  ${project_minimal.build_src_flags}
                  ${feature_audio.build_src_flags}
                  -DLANTERN=1
                  -DPROJECT_NAME="\"Lantern\""
                  -DNUM_RINGS=4
                  -DRING_SIZE_0=16
                  -DRING_SIZE_1=12
                  -DRING_SIZE_2=8
                  -DRING_SIZE_3=1
                  -DFAN_SIZE=RING_SIZE_0+RING_SIZE_1+RING_SIZE_2+RING_SIZE_3
                  -DMATRIX_WIDTH=6
                  -DMATRIX_HEIGHT=2
                  -DTIME_BEFORE_LOCAL=0
                  -DLED_PIN0=32
                  -DDEFAULT_EFFECT_INTERVAL=1000*60*60*24

; Set of lighted acrylic Christmas tree silhouettes with 24-LED rings on bare ESP32
[env:treeset]
extends         = dev_esp32
build_src_flags = ${project_minimal.build_src_flags}
                  ${feature_wifi.build_src_flags}
                  ${feature_ota.build_src_flags}
                  ${feature_remote.build_src_flags}
                  ${feature_audio.build_src_flags}
                  -DPROJECT_NAME="\"Treeset\""
                  -DINCOMING_WIFI_ENABLED=0
                  -DTIME_BEFORE_LOCAL=0
                  -DENABLE_NTP=0
                  -DLED_PIN0=26
                  -DRING_SIZE_0=24
                  -DMATRIX_WIDTH=5
                  -DMATRIX_HEIGHT=RING_SIZE_0
                  -DNUM_FANS=MATRIX_WIDTH
                  -DFAN_SIZE=MATRIX_HEIGHT
                  -DLED_FAN_OFFSET_BU=12

lib_deps        = ${base.bounce_deps}
                  ${base.network_deps}
                  ${dev_esp32.lib_deps}

