; Animated tabletop Christmas tree decorations with 24-LED rings on M5StickC-Plus
[env:xmastrees]
extends         = dev_m5stick_c_plus
build_src_flags = ${dev_m5stick_c_plus.build_src_flags}
                  ${project_minimal.build_src_flags}
                  ${feature_wifi.build_src_flags}
                  ${feature_remote.build_src_flags}
                  ${feature_audio.build_src_flags}
                  -DXMASTREES=1
                  -DPROJECT_NAME="\"X-mas Trees\""
                  -DTIME_BEFORE_LOCAL=2
                  -DDEFAULT_EFFECT_INTERVAL=60*60*24
                  -DLED_PIN0=26
                  -DRING_SIZE_0=24
                  -DMATRIX_WIDTH=24
                  -DMATRIX_HEIGHT=5
                  -DFAN_SIZE=MATRIX_WIDTH
                  -DNUM_FANS=MATRIX_HEIGHT
                  -DLED_FAN_OFFSET_BU=6

; 5x5x5 LED 3D cube (125 LEDs = 5 rings/layers of 25) on M5StickC-Plus
[env:cube]
extends         = dev_m5stick_c_plus
build_src_flags = ${dev_m5stick_c_plus.build_src_flags}
                  ${project_minimal_wifi_audio.build_src_flags}
                  -DPROJECT_NAME='"Cube"'
                  -DTIME_BEFORE_LOCAL=5
                  -DDEFAULT_EFFECT_INTERVAL=600000
                  -DLED_PIN0=26
                  -DRING_SIZE_0=25
                  -DMATRIX_WIDTH=5
                  -DMATRIX_HEIGHT=25
                  -DNUM_FANS=5
                  -DFAN_SIZE=25
                  -DNUM_LEDS=125
                  -DIR_REMOTE_PIN=26
                  -DLED_FAN_OFFSET_BU=6
                  -DCOLOR_ORDER=EOrder::RGB
                  -DEFFECTS_MINIMAL=1

; PDP-11 / DEC minicomputer front-panel blinkenlights simulation grid (37 LEDs) on M5StickC-Plus2
[env:pdpgrid]
extends         = dev_m5stick_c_plus2
build_src_flags = ${dev_m5stick_c_plus2.build_src_flags}
                  ${project_minimal.build_src_flags}
                  ${feature_wifi.build_src_flags}
                  ${feature_ota.build_src_flags}
                  ${feature_audio.build_src_flags}
                  -DPROJECT_NAME="\"PDPGrid\""
                  -DNUM_RINGS=4
                  -DRING_SIZE_0=16
                  -DRING_SIZE_1=12
                  -DRING_SIZE_2=8
                  -DRING_SIZE_3=1
                  -DFAN_SIZE=RING_SIZE_0+RING_SIZE_1+RING_SIZE_2+RING_SIZE_3
                  -DMATRIX_WIDTH=14
                  -DMATRIX_HEIGHT=16
                  -DPOWER_LIMIT_MW=1000
                  -DLED_PIN0=32
                  -DDEFAULT_EFFECT_INTERVAL=0

; WarGames W.O.P.R. / NORAD supercomputer military simulation display on M5StickC-Plus2
[env:pdpwopr]
extends         = dev_m5stick_c_plus2
build_src_flags = ${dev_m5stick_c_plus2.build_src_flags}
                  ${project_spectrum.build_src_flags}
                  ${feature_wifi.build_src_flags}
                  ${feature_ota.build_src_flags}
                  ${feature_remote.build_src_flags}
                  ${feature_audio_128.build_src_flags}
                  -DEFFECTS_PDPWOPR=1
                  -DPOWER_LIMIT_MW=1500
                  -DDEFAULT_EFFECT_INTERVAL=0
                  -DPROJECT_NAME="\"PDPWOPR\""
                  -DTIME_BEFORE_LOCAL=2
                  -DCOLORDATA_SERVER_ENABLED=0
                  -DLED_PIN0=32
                  -DMATRIX_WIDTH=16
                  -DMATRIX_HEIGHT=16

; Now for the Heltec, with WiFi and webserver enabled
; Heltec WiFi Kit 32 (ESP32 with onboard 0.96" monochrome SSD1306 OLED)
[env:heltecdemo]
extends         = dev_heltec_wifi
build_src_flags = ${dev_heltec_wifi.build_src_flags}
                  ${project_demo.build_src_flags}
                  ${feature_wifi.build_src_flags}

; Now for Heltec V2, which has 8M flash
; Heltec WiFi Kit 32 V2 (ESP32 with 8MB flash and onboard OLED)
[env:heltecv2demo]
extends         = dev_heltec_wifi_v2
build_src_flags = ${dev_heltec_wifi_v2.build_src_flags}
                  ${project_demo.build_src_flags}
                  ${feature_wifi.build_src_flags}

; Heltec WiFi Kit 32 V3 (ESP32-S3 with Type-C and onboard OLED)
[env:heltecv3demo]
extends         = dev_heltec_wifi_v3
build_src_flags = ${dev_heltec_wifi_v3.build_src_flags}
                  ${project_demo.build_src_flags}
                  ${feature_wifi.build_src_flags}
                  -DROTATE_SCREEN=1

; Heltec WiFi LoRa 32 V3 (ESP32-S3 with SX1262 LoRa packet radio and onboard OLED)
[env:helteclorav3demo]
extends         = dev_heltec_wifi_lora_v3
build_src_flags = ${dev_heltec_wifi_lora_v3.build_src_flags}
                  ${project_demo.build_src_flags}
                  ${feature_wifi.build_src_flags}

; LilyGO T-Display AMOLED (1.91" RM67162 high-res display on ESP32-S3)
[env:demo_amoled]
extends         = dev_lilygo_amoled
build_src_flags = ${dev_lilygo_amoled.build_src_flags}
                  ${project_demo.build_src_flags}
                  ${feature_wifi.build_src_flags}
                  ${feature_audio.build_src_flags}
                  -DPROJECT_NAME="\"M5Demo\""
                  -DMATRIX_WIDTH=144*5+38
                  -DTIME_BEFORE_LOCAL=2
                  -DENABLE_WEBSERVER=0
                  -DCOLORDATA_SERVER_ENABLED=0
                  -DDEFAULT_EFFECT_INTERVAL=60*60*24*5
                  -DNUM_BANDS=64
                  -DINPUT_PIN=41
                  -DUSE_I2S_AUDIO=1
                  -DI2S_BCLK_PIN=39
                  -DI2S_WS_PIN=42

; LilyGO T-Display S3 (1.9" ST7789 IPS LCD on ESP32-S3)
[env:lilygo-tdisplay-s3-demo]
extends         = dev_lilygo_tdisplay_s3
build_src_flags = ${dev_lilygo_tdisplay_s3.build_src_flags}
                  ${project_demo.build_src_flags}
                  ${feature_wifi.build_src_flags}

; Elecrow Mesmerizer (integrated 32x32 HUB75 matrix driver board)
[env:spectrum_elecrow]
extends         = dev_elecrow_mesmerizer
build_src_flags = ${project_spectrum.build_src_flags}
                  ${feature_audio.build_src_flags}
                  -DTFT_WIDTH=320
                  -DTFT_HEIGHT=480
                  -DSHOW_VU_METER=1
                  -DELECROW=1
                  -DUSE_I2S_AUDIO=1
                  -DUSE_SCREEN=1

lib_deps        = ${dev_elecrow_mesmerizer.lib_deps}

; Original M5StickC baseline demo (older 0.96" ST7735 80x160 TFT; superseded by m5plusdemo)
[env:m5demo]
extends         = dev_m5stick_c
build_src_flags = ${dev_m5stick_c.build_src_flags}
                  ${project_demo.build_src_flags}
                  ${feature_wifi.build_src_flags}
                  ${feature_audio.build_src_flags}
                  -DPROJECT_NAME="\"M5Demo\""
                  -DMATRIX_WIDTH=144*5+38
                  -DTIME_BEFORE_LOCAL=2
                  -DENABLE_WEBSERVER=0
                  -DCOLORDATA_SERVER_ENABLED=0
                  -DLED_PIN0=32

; Classic original M5Stack Core dev kit (2.0" 320x240 ILI9342 display with 3 bottom buttons)
[env:m5stackdemo]
extends         = dev_m5stack
build_src_flags = ${dev_m5stack.build_src_flags}
                  -DPROJECT_NAME="\"M5StackDemo\""

lib_deps        = ${dev_m5stack.lib_deps}
                  ${m5demobase.lib_deps}
board_build.embed_files = ${m5demobase.board_build.embed_files}

; Original M5StickC-Plus 48x16 audio spectrum visualizer (superseded by spectrum2)
[env:spectrum]
extends         = dev_m5stick_c_plus
build_src_flags = ${dev_m5stick_c_plus.build_src_flags}
                  ${project_spectrum.build_src_flags}
                  ${feature_wifi.build_src_flags}
                  ${feature_remote.build_src_flags}
                  ${feature_audio.build_src_flags}
                  -DPROJECT_NAME="\"Spectrum\""
                  -DTIME_BEFORE_LOCAL=2
                  -DMAX_BUFFERS=1
                  -DINCOMING_WIFI_ENABLED=0
                  -DCOLORDATA_SERVER_ENABLED=0
                  -DDEFAULT_EFFECT_INTERVAL=60*60*24*5
                  -DLED_PIN0=26
                  -DRING_SIZE_0=24
                  -DMATRIX_WIDTH=48
                  -DMATRIX_HEIGHT=16
                  -DSHOW_VU_METER=1

; Same as Spectrum but using a non-Plus M5 Stick (older version with smaller screen)
; Lightweight audio spectrum visualizer for original small-screen M5StickC without WiFi
[env:spectrumlite]
extends         = dev_m5stick_c
build_src_flags = ${dev_m5stick_c.build_src_flags}
                  ${project_spectrum.build_src_flags}
                  ${feature_audio.build_src_flags}

; Espressif ESP-WROVER-KIT official dev board running audio spectrum analyzer
[env:spectrum_wrover_kit]
extends         = dev_wrover
build_src_flags = ${project_spectrum.build_src_flags}
                  ${feature_audio.build_src_flags}
                  -DUSE_SCREEN=1
                  -DSPECTRUM_WROVER_KIT=1

lib_deps        = ${dev_wrover.lib_deps}
debug_init_break = tbreak setup

; Espressif ESP-WROVER-KIT driving a 144-LED strip and 24-LED ring
[env:wroverkit]
extends         = dev_wrover
build_src_flags = ${feature_wifi.build_src_flags}
                  ${feature_ota.build_src_flags}
                  -DWROVERKIT=1
                  -DPROJECT_NAME='"WROVER Kit"'
                  -DMATRIX_WIDTH=144
                  -DNUM_LEDS=144
                  -DNUM_RINGS=5
                  -DRING_SIZE_0=24
                  -DUSE_LCD=1
                  -DUSE_SCREEN=1
                  -DTIME_BEFORE_LOCAL=2

; ledstrip_feather is based off ledstrip but intended for the ESP32S3 TFT Feather from Adafruit with 2MB PSRAM
; Adafruit ESP32-S3 TFT Feather (2MB PSRAM + ST7789 color display) driving an LED strip
[env:ledstrip_feather]
extends         = dev_adafruit_feather
build_src_flags = ${dev_adafruit_feather.build_src_flags}
                  ${project_minimal.build_src_flags}

; Adafruit ESP32-S3 TFT Feather driving a 271-LED Hexagon PCB
[env:ledstrip_feather_hexagon]
extends         = dev_adafruit_feather
build_src_flags = ${dev_adafruit_feather.build_src_flags}
                  ${project_hexagon.build_src_flags}
                  ${feature_wifi.build_src_flags}
                  -DPROJECT_NAME="\"Feather Hexagon\""
                  -DMATRIX_WIDTH=271
                  -DDEFAULT_EFFECT_INTERVAL=1000*20

; Adafruit Feather ESP32 WROVER (classic ESP32 + PSRAM) driving an LED strip
[env:ledstrip_feather_wrover]
extends         = dev_wrover
build_src_flags = ${project_minimal.build_src_flags}
                  -DUSER_SETUP_LOADED

debug_init_break = tbreak setup

; Minimal, no-frills bare ESP32 LED strip without WiFi, audio, or display code
[env:ledstriplite]
extends         = dev_esp32
build_src_flags = ${project_minimal.build_src_flags}

; Unexpected Maker TinyPICO (ultra-miniature ESP32) driving an LED strip
[env:ledstrip_pico]
extends         = dev_tinypico
build_src_flags = ${project_minimal.build_src_flags}

; Catch-all generic ESP32 pinout template
[env:generic]
extends         = dev_esp32
build_src_flags = ${project_minimal.build_src_flags}
                  -DGENERIC=1
